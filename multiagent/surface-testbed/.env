# SURFACE 40-app paper testbed — lab secrets, not for production.
# All values are intentionally fixed so scans are reproducible.

COMPOSE_PROJECT_NAME=surface40

POSTGRES_USER=postgres
POSTGRES_PASSWORD=testbed_pass
MYSQL_ROOT_PASSWORD=testbed_root
MYSQL_USER=dvna
MYSQL_PASSWORD=passw0rd

OLLAMA_MODEL=qwen2.5:0.5b

# Typebot (32-char encryption secret)
TYPEBOT_ENCRYPTION_SECRET=Surface40TypebotEncryptKey32chr!
TYPEBOT_ADMIN_EMAIL=admin@testbed.local

# Rails / Phoenix app secrets (lab-only)
CHATWOOT_SECRET_KEY_BASE=surface40chatwootsecretkeybasepleasechangeinproduction0000000000000000000000000001
CHASKIQ_SECRET_KEY_BASE=surface40chaskiqsecretkeybasepleasechangeinproduction00000000000000000000000000001
PAPERCUPS_SECRET_KEY_BASE=Surface40PapercupsSecretKeyBaseMustBeAtLeastSixtyFourBytesLong!!

# Hostnames used for third-party-widget eTLD+1 split. Add to /etc/hosts:
#   127.0.0.1 store.testbed.local vendor.chat.local hubspot-embed.testbed.local
STORE_HOST=store.testbed.local
VENDOR_HOST=vendor.chat.local
HUBSPOT_HOST=hubspot-embed.testbed.local
