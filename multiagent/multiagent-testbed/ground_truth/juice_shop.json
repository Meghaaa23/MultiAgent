{
  "target": "juice_shop",
  "scope": "blackbox_unauth",
  "url_aliases": [
    "http://localhost:3141",
    "http://localhost:8017",
    "http://172.30.0.37",
    "http://172.30.0.37:3000"
  ],
  "endpoints_true": [
    "/rest/products/search",
    "/rest/user/login",
    "/api/Users",
    "/api/users",
    "/rest/admin/application-configuration"
  ],
  "endpoints_auth_gated": [
    "/api/Users",
    "/rest/user/whoami"
  ],
  "ai_surface": {
    "has_ai_surface": "no",
    "ai_endpoints_true": [],
    "ai_auth_gated": null,
    "chat_ui_present": false,
    "injection_authorized": true,
    "soft_404_behavior": "catch_all_spa",
    "stack_true": {"framework": "Angular SPA + Express REST API", "language": "TypeScript/Node.js"}
  },
  "expected_findings": [
    {
      "id": "js-csp",
      "type": "missing_header",
      "name": "Content-Security-Policy",
      "required": false,
      "category": "missing_check",
      "notes": "Depends on Juice Shop version/config"
    },
    {
      "id": "js-cors-wildcard",
      "type": "cors",
      "max_severity": "Low",
      "required": false,
      "category": "missing_check",
      "notes": "ACAO=* without ACAC must be Low if reported"
    },
    {
      "id": "js-sqli-search",
      "type": "sqli",
      "path": "/rest/products/search",
      "required": false,
      "category": "missing_check",
      "notes": "Public search SQLi — recall goal, not CI gate yet"
    },
    {
      "id": "js-admin-config",
      "type": "unauthenticated-access",
      "path": "application-configuration",
      "required": false,
      "category": "missing_check"
    }
  ],
  "out_of_scope_types": [
    "xxe",
    "jwt",
    "broken-auth",
    "nosqli"
  ],
  "must_not_report": [
    {
      "type": "missing csrf protection",
      "path": "/login",
      "reason": "SPA/JWT login CSRF is a soft FP in black-box unauth",
      "category": "logic_bug"
    },
    {
      "type": "cors",
      "match": "high_without_acac",
      "reason": "CORS High requires Allow-Credentials: true",
      "category": "logic_bug"
    },
    {
      "type": "sql injection (time-based blind)",
      "match": "evidence_status_0",
      "reason": "HTTP 0 timeout is not SLEEP confirmation",
      "category": "logic_bug"
    },
    {
      "type": "cross-site scripting",
      "match": "confirmed_without_js_execution",
      "reason": "Confirmed XSS requires js_execution",
      "category": "logic_bug"
    },
    {
      "type": "cve",
      "id": "CVE-2026-",
      "reason": "Fabricated/unverified future CVE IDs must not appear as findings",
      "category": "logic_bug"
    }
  ]
}
