# -*- mode: ruby -*-
# vi: set ft=ruby :
# ================================================================
# Vagrantfile — Automated sandbox VM for multiagent testbed
# Provisions Ubuntu 22.04 + Docker + all 20 containers
#
# Usage:
#   vagrant up         # create & provision VM (first time ~10–15 min)
#   vagrant ssh        # SSH into the VM
#   vagrant halt       # shut down VM
#   vagrant snapshot save clean-state
#   vagrant snapshot restore clean-state
# ================================================================

Vagrant.configure("2") do |config|

  config.vm.box = "ubuntu/jammy64"
  config.vm.hostname = "multiagent-testbed"

  # Forward all 20 app ports to host
  (1..20).each do |i|
    config.vm.network "forwarded_port",
      guest: 8000 + i,
      host:  8000 + i,
      host_ip: "127.0.0.1"
  end

  # Forward DB ports
  config.vm.network "forwarded_port", guest: 3306,  host: 3306,  host_ip: "127.0.0.1"
  config.vm.network "forwarded_port", guest: 5432,  host: 5432,  host_ip: "127.0.0.1"
  config.vm.network "forwarded_port", guest: 6379,  host: 6379,  host_ip: "127.0.0.1"
  config.vm.network "forwarded_port", guest: 27017, host: 27017, host_ip: "127.0.0.1"
  config.vm.network "forwarded_port", guest: 2222,  host: 2222,  host_ip: "127.0.0.1"

  # VM resources — adjust to your machine
  config.vm.provider "virtualbox" do |vb|
    vb.name   = "multiagent-testbed"
    vb.memory = 16384   # 16 GB — reduce to 8192 if tight
    vb.cpus   = 4
    vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
    vb.customize ["modifyvm", :id, "--ioapic", "on"]
  end

  # VMware Fusion alternative
  config.vm.provider "vmware_fusion" do |vmf|
    vmf.vmx["memsize"]  = "16384"
    vmf.vmx["numvcpus"] = "4"
  end

  # Sync testbed directory into VM
  config.vm.synced_folder ".", "/home/vagrant/testbed",
    type: "virtualbox",
    owner: "vagrant", group: "vagrant"

  # Provision: install Docker + start testbed
  config.vm.provision "shell", privileged: true, inline: <<-SHELL
    set -euo pipefail

    echo "==> Updating packages..."
    apt-get update -qq
    apt-get install -y -qq curl gnupg ca-certificates lsb-release iptables

    echo "==> Installing Docker..."
    install -m 0755 -d /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
      | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
    chmod a+r /etc/apt/keyrings/docker.gpg

    echo \
      "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
      https://download.docker.com/linux/ubuntu \
      $(lsb_release -cs) stable" \
      > /etc/apt/sources.list.d/docker.list

    apt-get update -qq
    apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-compose-plugin

    systemctl enable docker
    systemctl start docker
    usermod -aG docker vagrant

    echo "==> Pulling images and starting testbed..."
    cd /home/vagrant/testbed
    bash sandbox-setup.sh

    echo ""
    echo "══════════════════════════════════════"
    echo "  VM provisioned. Testbed is running."
    echo "  Access apps at http://localhost:8001"
    echo "  through http://localhost:8020"
    echo "══════════════════════════════════════"
  SHELL
end
