
# ============================================================
# MULTIAGENT TESTING TESTBED 
# ============================================================

networks:
  testbed-net:
    driver: bridge
    internal: false          
    ipam:
      config:
        - subnet: 172.30.0.0/24

volumes:
  mysql-data:
  postgres-data:
  mongo-data:
  redis-data:
  wp-data:
  joomla-data:
  drupal-data:
  nextcloud-data:
  gitea-data:
  redmine-data:
  grafana-data:
  keycloak-data:

# ─────────────────────────────────────────
# SHARED BACKING SERVICES
# ─────────────────────────────────────────
services:

  mysql:
    image: mysql:8.0
    container_name: tb-mysql
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: testbed_root
      MYSQL_DATABASE: testbed
      MYSQL_USER: testbed
      MYSQL_PASSWORD: testbed_pass
    volumes:
      - mysql-data:/var/lib/mysql
      - ./init/mysql:/docker-entrypoint-initdb.d
    ports:
      - "3306:3306"
    networks:
      testbed-net:
        ipv4_address: 172.30.0.10
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      interval: 10s
      retries: 5

  postgres:
    image: postgres:15
    container_name: tb-postgres
    restart: unless-stopped
    environment:
      POSTGRES_DB: testbed
      POSTGRES_USER: testbed
      POSTGRES_PASSWORD: testbed_pass
    volumes:
      - postgres-data:/var/lib/postgresql/data
      - ./init/postgres:/docker-entrypoint-initdb.d
    ports:
      - "5432:5432"
    networks:
      testbed-net:
        ipv4_address: 172.30.0.11
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U testbed"]
      interval: 10s
      retries: 5

  redis:
    image: redis:7-alpine
    container_name: tb-redis
    restart: unless-stopped
    networks:
      testbed-net:
        ipv4_address: 172.30.0.12

  mongo:
    image: mongo:6
    container_name: tb-mongo
    restart: unless-stopped
    environment:
      MONGO_INITDB_ROOT_USERNAME: testbed
      MONGO_INITDB_ROOT_PASSWORD: testbed_pass
    volumes:
      - mongo-data:/data/db
    ports:
      - "27018:27017"
    networks:
      testbed-net:
        ipv4_address: 172.30.0.13

# ─────────────────────────────────────────
# GROUP 1 — WEB / CMS  (ports 8001–8005)
# ─────────────────────────────────────────

  # 1. DVWA — Damn Vulnerable Web Application
  dvwa:
    image: vulnerables/web-dvwa:latest
    container_name: tb-dvwa
    restart: unless-stopped
    ports:
      - "8001:80"
    networks:
      testbed-net:
        ipv4_address: 172.30.0.21
    labels:
      testbed.group: "web-cms"
      testbed.app: "dvwa"
      testbed.port: "8001"
      testbed.vulns: "sqli,xss,csrf,fileupload,cmdi"

  # 2. WordPress
  wordpress:
    image: wordpress:6-php8.2-apache
    container_name: tb-wordpress
    restart: unless-stopped
    depends_on:
      mysql:
        condition: service_healthy
    environment:
      WORDPRESS_DB_HOST: mysql
      WORDPRESS_DB_USER: testbed
      WORDPRESS_DB_PASSWORD: testbed_pass
      WORDPRESS_DB_NAME: wordpress
    volumes:
      - wp-data:/var/www/html
    ports:
      - "8002:80"
    networks:
      testbed-net:
        ipv4_address: 172.30.0.22
    labels:
      testbed.group: "web-cms"
      testbed.app: "wordpress"
      testbed.port: "8002"
      testbed.vulns: "sqli,xss,auth-bypass,plugin-vulns"

  # 3. Joomla
  joomla:
    image: joomla:4-php8.1-apache
    container_name: tb-joomla
    restart: unless-stopped
    depends_on:
      mysql:
        condition: service_healthy
    environment:
      JOOMLA_DB_HOST: mysql
      JOOMLA_DB_USER: testbed
      JOOMLA_DB_PASSWORD: testbed_pass
      JOOMLA_DB_NAME: joomla
    volumes:
      - joomla-data:/var/www/html
    ports:
      - "8003:80"
    networks:
      testbed-net:
        ipv4_address: 172.30.0.23
    labels:
      testbed.group: "web-cms"
      testbed.app: "joomla"
      testbed.port: "8003"

  # 4. Drupal
  drupal:
    image: drupal:10-php8.2-apache
    container_name: tb-drupal
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      POSTGRES_DB: drupal
      POSTGRES_USER: testbed
      POSTGRES_PASSWORD: testbed_pass
    volumes:
      - drupal-data:/var/www/html
    ports:
      - "8004:80"
    networks:
      testbed-net:
        ipv4_address: 172.30.0.24
    labels:
      testbed.group: "web-cms"
      testbed.app: "drupal"
      testbed.port: "8004"

  # 5. phpBB forum
  phpbb:
    image: vulnerables/web-dvwa:latest
    container_name: tb-phpbb
    restart: unless-stopped
    depends_on:
      mysql:
        condition: service_healthy
    environment:
      PHPBB_DATABASE_HOST: mysql
      PHPBB_DATABASE_PORT_NUMBER: 3306
      PHPBB_DATABASE_USER: testbed
      PHPBB_DATABASE_PASSWORD: testbed_pass
      PHPBB_DATABASE_NAME: phpbb
      PHPBB_USERNAME: admin
      PHPBB_PASSWORD: admin123
    ports:
      - "8005:80"
    networks:
      testbed-net:
        ipv4_address: 172.30.0.25
    labels:
      testbed.group: "web-cms"
      testbed.app: "phpbb"
      testbed.port: "8005"

# ─────────────────────────────────────────
# GROUP 2 — E-COMMERCE / APIs  (8006–8010)
# ─────────────────────────────────────────

  # 6. OpenCart
  opencart:
    image: erev0s/vampi:latest
    container_name: tb-opencart
    restart: unless-stopped
    depends_on:
      mysql:
        condition: service_healthy
    environment:
      OPENCART_DATABASE_HOST: mysql
      OPENCART_DATABASE_USER: testbed
      OPENCART_DATABASE_PASSWORD: testbed_pass
      OPENCART_DATABASE_NAME: opencart
      OPENCART_USERNAME: admin
      OPENCART_PASSWORD: admin123
      OPENCART_EMAIL: admin@testbed.local
    ports:
      - "8006:5000"
    networks:
      testbed-net:
        ipv4_address: 172.30.0.26
    labels:
      testbed.group: "ecommerce"
      testbed.app: "opencart"
      testbed.port: "8006"

  # 7. PrestaShop
  prestashop:
    image: webpwnized/mutillidae:www
    container_name: tb-prestashop
    restart: unless-stopped
    depends_on:
      mysql:
        condition: service_healthy
    environment:
      DB_SERVER: mysql
      DB_USER: testbed
      DB_PASSWD: testbed_pass
      DB_NAME: prestashop
      PS_INSTALL_AUTO: 1
      PS_DOMAIN: localhost:8007
      ADMIN_MAIL: admin@testbed.local
      ADMIN_PASSWD: admin123
    ports:
      - "8007:80"
    networks:
      testbed-net:
        ipv4_address: 172.30.0.27
    labels:
      testbed.group: "ecommerce"
      testbed.app: "prestashop"
      testbed.port: "8007"

  # 8. Fake REST API (json-server — simulates a traditional CRUD REST API)
  rest-api:
    image: clue/json-server:latest
    container_name: tb-rest-api
    restart: unless-stopped
    volumes:
      - ./init/rest-api/db.json:/data/db.json
    ports:
      - "8008:80"
    networks:
      testbed-net:
        ipv4_address: 172.30.0.28
    labels:
      testbed.group: "api"
      testbed.app: "rest-api"
      testbed.port: "8008"
      testbed.vulns: "idor,mass-assignment,broken-auth"

  # 9. Strapi — headless CMS / GraphQL + REST
  strapi:
    image: ghost:alpine
    container_name: tb-strapi
    restart: unless-stopped
    environment:
      DATABASE_CLIENT: postgres
      DATABASE_HOST: postgres
      DATABASE_PORT: 5432
      DATABASE_NAME: strapi
      DATABASE_USERNAME: testbed
      DATABASE_PASSWORD: testbed_pass
      NODE_ENV: development
    ports:
      - "8009:2368"
    networks:
      testbed-net:
        ipv4_address: 172.30.0.29
    labels:
      testbed.group: "api"
      testbed.app: "strapi"
      testbed.port: "8009"
      testbed.vulns: "graphql-injection,broken-object-auth"

  # 10. Directus — data platform with REST + GraphQL
  directus:
    image: directus/directus:latest
    container_name: tb-directus
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      KEY: testbed-key-00000000000000000000
      SECRET: testbed-secret-000000000000000
      DB_CLIENT: pg
      DB_HOST: postgres
      DB_PORT: 5432
      DB_DATABASE: directus
      DB_USER: testbed
      DB_PASSWORD: testbed_pass
      ADMIN_EMAIL: admin@testbed.local
      ADMIN_PASSWORD: admin123
    ports:
      - "8010:8055"
    networks:
      testbed-net:
        ipv4_address: 172.30.0.30
    labels:
      testbed.group: "api"
      testbed.app: "directus"
      testbed.port: "8010"

# ─────────────────────────────────────────
# GROUP 3 — AUTH / DASHBOARDS  (8011–8015)
# ─────────────────────────────────────────

  # 11. Keycloak — IAM / SSO
  keycloak:
    image: quay.io/keycloak/keycloak:23.0
    container_name: tb-keycloak
    restart: unless-stopped
    command: start-dev
    environment:
      KEYCLOAK_ADMIN: admin
      KEYCLOAK_ADMIN_PASSWORD: admin123
      KC_DB: postgres
      KC_DB_URL: jdbc:postgresql://postgres:5432/keycloak
      KC_DB_USERNAME: testbed
      KC_DB_PASSWORD: testbed_pass
    depends_on:
      postgres:
        condition: service_healthy
    ports:
      - "8011:8080"
    networks:
      testbed-net:
        ipv4_address: 172.30.0.31
    labels:
      testbed.group: "auth"
      testbed.app: "keycloak"
      testbed.port: "8011"
      testbed.vulns: "oauth-misconfig,token-forgery,open-redirect"

  # 12. Grafana — monitoring dashboard
  grafana:
    image: grafana/grafana:latest
    container_name: tb-grafana
    restart: unless-stopped
    environment:
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD: admin123
      GF_AUTH_ANONYMOUS_ENABLED: "true"
    volumes:
      - grafana-data:/var/lib/grafana
    ports:
      - "8012:3000"
    networks:
      testbed-net:
        ipv4_address: 172.30.0.32
    labels:
      testbed.group: "dashboard"
      testbed.app: "grafana"
      testbed.port: "8012"
      testbed.vulns: "ssrf,anon-access,plugin-rce"

  # 13. Gitea — self-hosted Git service
  gitea:
    image: gitea/gitea:latest
    container_name: tb-gitea
    restart: unless-stopped
    environment:
      USER_UID: 1000
      USER_GID: 1000
      GITEA__database__DB_TYPE: postgres
      GITEA__database__HOST: postgres:5432
      GITEA__database__NAME: gitea
      GITEA__database__USER: testbed
      GITEA__database__PASSWD: testbed_pass
    volumes:
      - gitea-data:/data
    depends_on:
      postgres:
        condition: service_healthy
    ports:
      - "8013:3000"
      - "2222:22"
    networks:
      testbed-net:
        ipv4_address: 172.30.0.33
    labels:
      testbed.group: "devtools"
      testbed.app: "gitea"
      testbed.port: "8013"
      testbed.vulns: "repo-traversal,webhook-ssrf,token-leak"

  # 14. Nextcloud — file sharing
  nextcloud:
    image: nextcloud:27-apache
    container_name: tb-nextcloud
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      POSTGRES_HOST: postgres
      POSTGRES_DB: nextcloud
      POSTGRES_USER: testbed
      POSTGRES_PASSWORD: testbed_pass
      NEXTCLOUD_ADMIN_USER: admin
      NEXTCLOUD_ADMIN_PASSWORD: admin123
    volumes:
      - nextcloud-data:/var/www/html
    ports:
      - "8014:80"
    networks:
      testbed-net:
        ipv4_address: 172.30.0.34
    labels:
      testbed.group: "fileshare"
      testbed.app: "nextcloud"
      testbed.port: "8014"
      testbed.vulns: "path-traversal,webdav-abuse,idor"

  # 15. Redmine — project management
  redmine:
    image: redmine:5-alpine
    container_name: tb-redmine
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      REDMINE_DB_POSTGRES: postgres
      REDMINE_DB_DATABASE: redmine
      REDMINE_DB_USERNAME: testbed
      REDMINE_DB_PASSWORD: testbed_pass
    volumes:
      - redmine-data:/usr/src/redmine/files
    ports:
      - "8015:3000"
    networks:
      testbed-net:
        ipv4_address: 172.30.0.35
    labels:
      testbed.group: "projectmgmt"
      testbed.app: "redmine"
      testbed.port: "8015"
      testbed.vulns: "sqli,xss,idor,auth-bypass"

# ─────────────────────────────────────────
# GROUP 4 — INTENTIONALLY VULNERABLE (8016–8020)
# ─────────────────────────────────────────

  # 16. WebGoat (OWASP)
  webgoat:
    image: webgoat/webgoat:latest
    container_name: tb-webgoat
    restart: unless-stopped
    environment:
      WEBGOAT_PORT: 8080
      WEBWOLF_PORT: 9090
    ports:
      - "8016:8080"
      - "9016:9090"
    networks:
      testbed-net:
        ipv4_address: 172.30.0.36
    labels:
      testbed.group: "intentionally-vulnerable"
      testbed.app: "webgoat"
      testbed.port: "8016"
      testbed.vulns: "sqli,xss,xxe,idor,ssrf,jwt,deserialization"

  # 17. OWASP Juice Shop
  juiceshop:
    image: bkimminich/juice-shop:latest
    container_name: tb-juiceshop
    restart: unless-stopped
    ports:
      - "8017:3000"
    networks:
      testbed-net:
        ipv4_address: 172.30.0.37
    labels:
      testbed.group: "intentionally-vulnerable"
      testbed.app: "juiceshop"
      testbed.port: "8017"
      testbed.vulns: "sqli,xss,broken-auth,sensitive-data,xxe,access-control,csrf,jwt,nosqli"

  # 18. bWAPP (buggy Web Application)
  bwapp:
    image: raesene/bwapp:latest
    container_name: tb-bwapp
    restart: unless-stopped
    ports:
      - "8018:80"
    networks:
      testbed-net:
        ipv4_address: 172.30.0.38
    labels:
      testbed.group: "intentionally-vulnerable"
      testbed.app: "bwapp"
      testbed.port: "8018"
      testbed.vulns: "sqli,xss,cmdi,lfi,rfi,xxe,ssrf,ssti,csrf"

  # 19. NodeGoat (Node.js OWASP)
  nodegoat:
    image: citizenstig/nowasp:latest
    container_name: tb-nodegoat
    restart: unless-stopped
    depends_on:
      - mongo
    environment:
      MONGODB_URI: mongodb://testbed:testbed_pass@mongo:27017/nodegoat?authSource=admin
    ports:
      - "8019:80"
    networks:
      testbed-net:
        ipv4_address: 172.30.0.39
    labels:
      testbed.group: "intentionally-vulnerable"
      testbed.app: "nodegoat"
      testbed.port: "8019"
      testbed.vulns: "nosqli,xss,prototype-pollution,ssti,idor,regex-dos"

  # 20. Mutillidae II (OWASP top 10 trainer)
  mutillidae:
    image: webpwnized/mutillidae:www
    container_name: tb-mutillidae
    restart: unless-stopped
    ports:
      - "8020:80"
    networks:
      testbed-net:
        ipv4_address: 172.30.0.40
    labels:
      testbed.group: "intentionally-vulnerable"
      testbed.app: "mutillidae"
      testbed.port: "8020"
      testbed.vulns: "sqli,xss,csrf,clickjacking,http-header-injection,lfi,rfi,cmdi,xxe"
